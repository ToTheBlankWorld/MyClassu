# MyClassu environment configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=

# Supabase PUBLISHABLE key (client-side safe, e.g. sb_publishable_... or the
# legacy anon key). NEVER put the service-role key or database password here.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server-side report delivery (NOT app configuration — documented here only
# so deployers know the exact secret names; set them with
# `supabase secrets set`, never in `.env`, never in the app, never in Git):
#
# AGENTMAIL_API_KEY      AgentMail private API key (Edge Function secret)
# AGENTMAIL_FROM_ADDRESS Verified sender, e.g. reports@myclassu.app
# ---------------------------------------------------------------------------
