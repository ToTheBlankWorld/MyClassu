<?xml version="1.0" encoding="utf-8"?>
<!--
  Class-start alarm screen. Fixed dark treatment (alarms must render
  identically with the app dead, so no theme bridge): warm near-black,
  lagoon-teal accent, generous type scale. Mirrors the app's visual
  hierarchy: overline → subject → code → time → room → faculty → action.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121110"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="72dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/alarm_test_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/alarm_test_badge"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="TEST ALARM"
            android:textColor="#6FC7BC"
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLASS STARTING"
            android:textColor="#A19A8F"
            android:textSize="13sp"
            android:letterSpacing="0.18" />

        <TextView
            android:id="@+id/alarm_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/alarm_course_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:textColor="#45AFA2"
            android:textSize="17sp"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/alarm_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_horizontal"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/alarm_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:textColor="#A19A8F"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/alarm_instructor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:textColor="#A19A8F"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/alarm_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/alarm_in_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:backgroundTint="#45AFA2"
                android:text="I'M IN CLASS"
                android:textAllCaps="false"
                android:textColor="#121110"
                android:textSize="17sp" />

            <Button
                android:id="@+id/alarm_not_in_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:background="@drawable/alarm_outline_button"
                android:text="I'M NOT IN CLASS"
                android:textAllCaps="false"
                android:textColor="#45AFA2"
                android:textSize="17sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/reason_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="WHY DID YOU MISS IT?"
                android:textColor="#A19A8F"
                android:textSize="13sp"
                android:letterSpacing="0.18" />

            <TextView
                android:id="@+id/reason_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <RadioGroup
                android:id="@+id/reason_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/reason_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Custom reason (optional)"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C564E"
                android:textSize="16sp"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/reason_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="Choose a reason to submit"
                android:textColor="#CC5544"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/reason_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="56dp"
                android:backgroundTint="#45AFA2"
                android:text="Submit"
                android:textAllCaps="false"
                android:textColor="#121110"
                android:textSize="17sp" />

            <Button
                android:id="@+id/reason_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:background="@drawable/alarm_outline_button"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#45AFA2"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
