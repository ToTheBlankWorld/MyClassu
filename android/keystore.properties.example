# MyClassu release-signing configuration (TEMPLATE — placeholders only).
#
# 1. Copy this file to `android/keystore.properties` (same directory).
# 2. Fill in the REAL values on the release machine only.
# 3. NEVER commit `keystore.properties`, the keystore file, or these
#    passwords to Git (both are gitignored). Back up the keystore
#    offline: losing it means the app can never be updated in place
#    again — a new application ID would be required.
#
# Create the keystore once with (JDK 21 keytool):
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore myclassu-release.keystore -alias myclassu \
#     -keyalg RSA -keysize 2048 -validity 10950
# The Gradle build fails loudly when this file or any value is missing
# (see android/app/build.gradle) — a release artifact is never silently
# signed with the debug key.

storeFile=myclassu-release.keystore
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=myclassu
keyPassword=REPLACE_WITH_KEY_PASSWORD
# NOTE: for PKCS12 keystores (keytool default) the key password MUST equal
# the store password — set both to the same value.
